# Copy to .env and fill in real values. NEVER commit the real .env.
NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_DIALECT=mysql

# Dev-only schema sync switches (config/dbSync.js). Keep DB_FORCE=false —
# it DROPS ALL TABLES when true.
DB_SYNC=false
DB_FORCE=false
DB_ALTER=false

# Use a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# SMTP (Gmail App Password if using Gmail) — used for password-reset OTP mail.
EMAIL_USER=your_mailbox@example.com
EMAIL_PASS=your_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# ── Admin portal (Phase 3) ──────────────────────────────────────────────────────
# Signing secret for Admin sessions. MUST be different from JWT_SECRET and at least 32 characters.
# If it is missing/short/equal to JWT_SECRET the Admin API answers 503 (fails closed).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=replace_with_a_different_long_random_secret
# Admin session lifetime in minutes (default 240, max 1440)
ADMIN_ACCESS_TOKEN_TTL_MINUTES=240

# ── Inventory & Batch Management (Phase 5) ──────────────────────────────────────
# A batch is "Near Expiry" when it expires within this many days (1–730). Default 90 — the outermost
# bucket of the Admin dashboard. Process-wide until a Settings module exists.
# INVENTORY_NEAR_EXPIRY_DAYS=90

# ── Phase 17: production hardening ───────────────────────────────────────────────
# Allowed browser origin of the frontend (default http://localhost:5173 — MUST be set in production)
# CORS_ORIGIN=https://dms.example.com
# Behind a reverse proxy: number of proxy hops (or an address list) so req.ip is the real client for rate limiting
# TRUST_PROXY=1
# JSON request body limit (default 100kb)
# JSON_BODY_LIMIT=100kb
# Rate limiting is per process (requests / minute / admin). RATE_LIMIT_DISABLED=true switches it off (not recommended).
# RATE_LIMIT_DISABLED=false
# RATE_LIMIT_ERP_TEST_PER_MIN=10   RATE_LIMIT_ERP_SYNC_PER_MIN=20   RATE_LIMIT_ERP_AUDIT_PER_MIN=60   RATE_LIMIT_ERP_READ_PER_MIN=600
# RATE_LIMIT_ERP_WRITE_PER_MIN=60  RATE_LIMIT_ERP_HEAVY_PER_MIN=60  RATE_LIMIT_ERP_OUTBOUND_PER_MIN=120 RATE_LIMIT_REPORT_PER_MIN=120 RATE_LIMIT_LOGIN_PER_MIN=30
# ERP network policy (see PHASE17_DELIVERABLES.md §7). Defaults in production: https only, no private / loopback / link-local / metadata addresses.
# ERP_ALLOWED_HOSTS=sap.example.com,erp2.example.com   # when set, ONLY these hosts may be used as ERP URLs
# ERP_ALLOW_PRIVATE_NETWORK=false                      # true = allow 10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7 (on-premise / VPN ERP)
# ERP_ALLOW_HTTP=false                                 # true = allow plain http:// in production (not recommended)
# ERP_DNS_CHECK=true                                   # resolve ERP host names at connect time and refuse internal answers (default: on in production)
# Scheduler / worker limits (clamped to safe ranges)
# ERP_SCHEDULER_ENABLED=true  ERP_SCHEDULER_INTERVAL_SECONDS=30  ERP_SYNC_MAX_CONCURRENT=2  ERP_SYNC_STALE_MINUTES=15
# ERP_SYNC_AUTO_MAX_RETRIES=3 ERP_SYNC_AUTO_RETRY_BASE_MINUTES=2 ERP_SYNC_AUTO_RETRY_MAX_DELAY_MINUTES=120 ERP_SHUTDOWN_GRACE_SECONDS=20
# A passing connection test older than this is reported as DEGRADED instead of CONNECTED (hours, default 24)
# ERP_TEST_STALE_HOURS=24
