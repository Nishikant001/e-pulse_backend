# Copy to .env and fill in real values. NEVER commit the real .env.
NODE_ENV=development
PORT=3002

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=Nishi@2000
DB_NAME=pharma_db
DB_DIALECT=mysql

# Dev-only schema sync switches (config/dbSync.js). Keep DB_FORCE=false —
# it DROPS ALL TABLES when true.
DB_SYNC=false
DB_FORCE=false
DB_ALTER=false

# Use a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn

EMAIL_USER=sahoonishikant008@gmail.com
EMAIL_PASS=acfaxtbtbunzuscj
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# ── Admin portal (Phase 3) ──────────────────────────────────────────────────────
# Signing secret for Admin sessions. MUST be different from JWT_SECRET and at least 32 characters.
# If it is missing/short/equal to JWT_SECRET the Admin API answers 503 (fails closed).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=9b7c1c1007b7849832b844a17cdda85c5f852a7630c990fd263197ca8c3de01bce9175f29f0f2ac51a66f8d78043194f
# Admin session lifetime in minutes (default 240, max 1440)
ADMIN_ACCESS_TOKEN_TTL_MINUTES=240

